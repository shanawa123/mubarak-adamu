// ShinkafiRide.ng - Prisma Schema Definition
// Production PostgreSQL Configuration with all 32 Normalized Entities

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PASSENGER
  DRIVER
  OPERATOR
  ADMIN
  SECURITY_OFFICER
}

enum RideStatus {
  DRAFT
  REQUESTED
  SEARCHING
  DRIVER_ASSIGNED
  DRIVER_ARRIVING
  DRIVER_ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum DriverStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum VehicleCategory {
  SEDAN
  KEKE_TRICYCLE
  INTERCITY_VAN
  CARGO_PICKUP
}

enum IncidentPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  NEW
  ACKNOWLEDGED
  UNDER_INVESTIGATION
  ESCALATED
  RESOLVED
  CLOSED
}

// 1. users
model User {
  id               String            @id @default(uuid())
  phone            String            @unique
  email            String?           @unique
  passwordHash     String
  salt             String
  role             Role              @default(PASSENGER)
  isVerified       Boolean           @default(false)
  isSuspended      Boolean           @default(false)
  suspensionReason String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  userProfile      UserProfile?
  passengerProfile PassengerProfile?
  driverProfile    DriverProfile?
  operatorProfile  OperatorProfile?
  payments         Payment[]
  transactions     Transaction[]
  notifications    Notification[]
  auditLogs        AuditLog[]

  @@index([phone])
  @@index([role])
}

// 2. user_profiles
model UserProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName          String
  preferredLanguage String   @default("Hausa / English")
  avatarUrl         String?
  address           String?
  city              String   @default("Shinkafi")
  state             String   @default("Zamfara State")
  updatedAt         DateTime @updatedAt
}

// 3. passenger_profiles
model PassengerProfile {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emergencyContactName  String?
  emergencyContactPhone String?
  preferredPayment      String   @default("cash")
  totalRides            Int      @default(0)
  rating                Float    @default(5.0)
  createdAt             DateTime @default(now())
}

// 4. driver_profiles
model DriverProfile {
  id                 String           @id @default(uuid())
  userId             String           @unique
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  operatorId         String?
  licenseNumber      String           @unique
  licenseExpiry      DateTime
  status             DriverStatus     @default(PENDING)
  reviewedBy         String?
  reviewNotes        String?
  reviewDate         DateTime?
  isOnline           Boolean          @default(false)
  currentLat         Float            @default(13.0782)
  currentLng         Float            @default(6.5195)
  lastLocationUpdate DateTime         @default(now())
  assignedVehicleId  String?
  totalTrips         Int              @default(0)
  rating             Float            @default(5.0)
  totalEarnings      Decimal          @default(0.0) @db.Decimal(12, 2)
  documents          DriverDocument[]
  createdAt          DateTime         @default(now())
}

// 5. driver_documents
model DriverDocument {
  id                 String        @id @default(uuid())
  driverId           String
  driver             DriverProfile @relation(fields: [driverId], references: [userId], onDelete: Cascade)
  documentType       String
  documentNumber     String
  fileUrl            String
  expiryDate         DateTime
  verificationStatus String        @default("pending")
  uploadedAt         DateTime      @default(now())

  @@index([driverId])
}

// 6. operator_profiles
model OperatorProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName     String
  cacNumber       String   @unique
  contactPerson   String
  phone           String
  businessAddress String
  isApproved      Boolean  @default(false)
  approvedBy      String?
  approvedAt      DateTime?
  totalVehicles   Int      @default(0)
  commissionRate  Float    @default(15.0)
  createdAt       DateTime @default(now())
}

// 7. vehicles
model Vehicle {
  id                   String          @id @default(uuid())
  operatorId           String?
  driverId             String?
  make                 String
  model                String
  year                 Int
  plateNumber          String          @unique
  color                String
  category             VehicleCategory @default(SEDAN)
  capacity             Int             @default(4)
  status               String          @default("active")
  insuranceExpiry      DateTime
  roadworthinessExpiry DateTime
  createdAt            DateTime        @default(now())

  @@index([operatorId])
  @@index([plateNumber])
}

// 8. rides
model Ride {
  id                  String              @id @default(uuid())
  passengerId         String
  driverId            String?
  vehicleId           String?
  serviceAreaId       String
  category            VehicleCategory     @default(SEDAN)
  pickupAddress       String
  pickupLat           Float
  pickupLng           Float
  destinationAddress  String
  destLat             Float
  destLng             Float
  estimatedDistanceKm Float
  estimatedDurationMin Int
  estimatedFare       Decimal             @db.Decimal(10, 2)
  finalFare           Decimal?            @db.Decimal(10, 2)
  platformCommission  Decimal             @db.Decimal(10, 2)
  netDriverEarnings   Decimal             @db.Decimal(10, 2)
  paymentMethod       String              @default("cash")
  paymentStatus       String              @default("pending")
  verificationOtp     String
  status              RideStatus          @default(REQUESTED)
  cancellationReason  String?
  cancelledBy         String?
  passengerRating     Int?
  passengerFeedback   String?
  driverFeedback      String?
  createdAt           DateTime            @default(now())
  acceptedAt          DateTime?
  arrivedAt           DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  statusHistory       RideStatusHistory[]
  payments            Payment[]
  incidents           Incident[]

  @@index([passengerId])
  @@index([driverId])
  @@index([status])
}

// 9. ride_status_history
model RideStatusHistory {
  id         String   @id @default(uuid())
  rideId     String
  ride       Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  fromStatus String
  toStatus   String
  changedBy  String
  notes      String?
  timestamp  DateTime @default(now())

  @@index([rideId])
}

// 10. fare_rules
model FareRule {
  id                   String          @id @default(uuid())
  category             VehicleCategory @unique
  serviceArea          String
  baseFare             Decimal         @db.Decimal(10, 2)
  perKmRate            Decimal         @db.Decimal(10, 2)
  perMinuteRate        Decimal         @db.Decimal(10, 2)
  minimumFare          Decimal         @db.Decimal(10, 2)
  cancellationFee      Decimal         @db.Decimal(10, 2)
  commissionPercentage Float           @default(15.0)
  currency             String          @default("NGN")
  updatedAt            DateTime        @updatedAt
}

// 11. payments
model Payment {
  id        String   @id @default(uuid())
  rideId    String?
  ride      Ride?    @relation(fields: [rideId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  provider  String
  reference String   @unique
  amount    Decimal  @db.Decimal(10, 2)
  currency  String   @default("NGN")
  status    String   @default("pending")
  channel   String
  paidAt    DateTime?
  createdAt DateTime @default(now())

  @@index([reference])
}

// 12. transactions
model Transaction {
  id           String   @id @default(uuid())
  reference    String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  type         String
  amount       Decimal  @db.Decimal(10, 2)
  balanceAfter Decimal  @db.Decimal(10, 2)
  description  String
  createdAt    DateTime @default(now())

  @@index([userId])
}

// 13. incidents
model Incident {
  id                 String           @id @default(uuid())
  ticketNumber       String           @unique
  rideId             String?
  ride               Ride?            @relation(fields: [rideId], references: [id])
  reportedByUserId   String
  reportedRole       Role
  category           String
  priority           IncidentPriority @default(MEDIUM)
  status             IncidentStatus   @default(NEW)
  subject            String
  description        String
  latitude           Float?
  longitude          Float?
  assignedOfficerId  String?
  assignedOfficerName String?
  escalatedToPolice  Boolean          @default(false)
  resolutionSummary  String?
  resolvedAt         DateTime?
  closedAt           DateTime?
  notes              IncidentNote[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([ticketNumber])
  @@index([status])
  @@index([priority])
}

// 14. incident_notes
model IncidentNote {
  id         String   @id @default(uuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  authorId   String
  authorName String
  content    String
  isPrivate  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([incidentId])
}

// 15. audit_logs
model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  userRole   String
  action     String
  entityType String
  entityId   String
  details    String
  ipAddress  String?
  timestamp  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([timestamp])
}

// 16. notifications
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
